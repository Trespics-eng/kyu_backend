NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# Server uses these; never add secret values to kyuconnect's VITE_* variables.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-server-only-secret-key
SUPABASE_BUCKET=Community

# Optional transactional email configuration.
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=verified-sender@example.com
BREVO_SENDER_NAME=Kyu-Konnekt
EMAIL_FROM_NAME=Kyu-Konnekt

LOG_LEVEL=debug
SENTRY_DSN=

# KyU AI Intelligence Agent Configuration
# Put your Gemini API key or OpenAI API key here:
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash
# Choose auto (Gemini then GPT), gemini, or openai. Both keys may be configured.
AI_PROVIDER=auto
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL_SUMMARY=gpt-4o-mini
OPENAI_MODEL_REASONING=gpt-4o
ENCRYPTION_SECRET=kyu_konnekt_ai_super_secret_32char_key!

# Gmail read-only OAuth credentials. Register FRONTEND_URL/api/v1/ai/email/callback
# as an authorized redirect URI in the Google Cloud OAuth client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

